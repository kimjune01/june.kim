---
import '../../styles/blog.css';

const canonicalUrl = 'https://june.kim/claim-audits/';
const pageTitle = 'Independent AI Claim Audits | Construct Validity | June Kim';
const pageDescription = 'Independent audits for teams defending consequential AI-system claims to customers, investors, reviewers, or regulators, with public rerunnable receipts.';
const socialImage = 'https://june.kim/assets/default-icon.png';
const subject = encodeURIComponent('An AI-system claim for independent audit');
const body = encodeURIComponent(`Claim about the AI system:

Decision that depends on it:

Evidence currently offered:

System or artifact:

Relevant deadline:`);
const inquiryHref = `mailto:june@june.kim?subject=${subject}&body=${body}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription}>
  <meta name="author" content="June Kim">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <link rel="canonical" href={canonicalUrl}>

  <meta property="og:type" content="website">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDescription}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:site_name" content="june.kim">
  <meta property="og:locale" content="en_CA">
  <meta property="og:image" content={socialImage}>
  <meta property="og:image:width" content="288">
  <meta property="og:image:height" content="293">
  <meta property="og:image:alt" content="June Kim">

  <meta name="twitter:card" content="summary">
  <meta name="twitter:site" content="@kimjune01">
  <meta name="twitter:creator" content="@kimjune01">
  <meta name="twitter:title" content={pageTitle}>
  <meta name="twitter:description" content={pageDescription}>
  <meta name="twitter:image" content={socialImage}>
  <meta name="twitter:image:alt" content="June Kim">

  <link rel="icon" href="/images/favicon.png">
  <link rel="alternate" type="application/rss+xml" title="june.kim" href="https://june.kim/feed.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;700&display=swap" rel="stylesheet">
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${canonicalUrl}#service`,
    name: 'Independent AI Claim Audit',
    serviceType: 'Independent construct-validity audit of an AI-system claim',
    description: pageDescription,
    url: canonicalUrl,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonicalUrl,
    },
    provider: {
      '@type': 'Person',
      name: 'June Kim',
      url: 'https://june.kim',
      email: 'mailto:june@june.kim',
      sameAs: [
        'https://github.com/kimjune01',
        'https://orcid.org/0009-0005-3153-9396',
      ],
    },
    audience: {
      '@type': 'Audience',
      audienceType: 'AI founders, evaluation leads, technology buyers, and researchers',
    },
    offers: {
      '@type': 'Offer',
      priceSpecification: {
        '@type': 'PriceSpecification',
        minPrice: 3000,
        maxPrice: 5000,
        priceCurrency: 'USD',
      },
    },
    areaServed: 'Worldwide',
    image: socialImage,
  })} />
</head>
<body>
  <aside class="logo">
    <a href="/">
      <img src="/images/gravatar.png" width="80" height="80" class="gravatar" alt="June Kim">
    </a>
    <span class="logo-prompt">Home</span>
  </aside>

  <main class="fade-shift">
    <section class="audit-page">
      <header class="intro">
        <h1>Can you defend what you claim about your AI system?</h1>
        <p class="dek">Before a customer, investor, reviewer, or regulator asks, know what your evidence supports, under which conditions, and where it stops.</p>
        <p class="bound"><strong>One claim. One investigation. One report.</strong><br><span class="price">US$3,000–$5,000 per engagement</span></p>
        <p><a class="action" href={inquiryHref}>Send an AI-system claim</a></p>
        <p class="aside">I will first tell you whether it is suitable for a bounded audit.</p>
      </header>

      <nav class="section-nav" aria-label="On this page">
        <a href="/claim-audits/#evidence">evidence</a>
        <a href="/claim-audits/#fit">when it fits</a>
        <a href="/claim-audits/#deliverable">deliverable</a>
        <a href="/claim-audits/#publication">publication</a>
        <a href="/claim-audits/#independence">independence</a>
      </nav>

      <hr>

      <p>I provide one-time independent audits of consequential AI-system claims for teams preparing to defend those claims to customers, investors, reviewers, or regulators, with falsifiers fixed before results and a sanitized report published with rerunnable receipts.</p>
      <p>The claim may concern an agent's reliability, a safeguard's coverage, a benchmark score, a security property, or whether a published result can be reproduced. Most AI audits ask whether a system passes its tests; this one asks whether those tests distinguish the claimed property from plausible alternatives. The result is a bounded verdict with tests, limitations, and rerunnable receipts.</p>
      <p>Payment buys the investigation. It does not buy endorsement, certification, or a particular verdict.</p>

      <figure class="process-figure">
        <svg viewBox="0 0 680 190" role="img" aria-labelledby="process-title process-desc" xmlns="http://www.w3.org/2000/svg">
          <title id="process-title">From claim to independent audit report</title>
          <desc id="process-desc">A claim about an AI system passes through preregistered falsifiers and tests, producing a signed report with rerunnable evidence.</desc>
          <defs>
            <marker id="arrowhead" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto">
              <path d="M0 0L7 3.5L0 7Z" fill="#777" />
            </marker>
          </defs>

          <g class="paper claim-paper">
            <path d="M24 32H130L154 56V158H24Z" />
            <path d="M130 32V56H154" />
            <path class="ink" d="M48 78H126M48 98H130M48 118H105" />
            <text x="24" y="18">AI-SYSTEM CLAIM</text>
          </g>

          <path class="flow" d="M174 95H228" />

          <g class="test-box">
            <rect x="246" y="35" width="178" height="120" rx="2" />
            <text x="335" y="63" text-anchor="middle">FIX THE FALSIFIERS</text>
            <path class="ink" d="M274 84H396M274 104H382M274 124H390" />
            <path class="tick" d="M272 82L278 88L287 76M272 102L278 108L287 96M272 122L278 128L287 116" />
          </g>

          <path class="flow" d="M442 95H496" />

          <g class="papers receipt-papers">
            <path class="back-paper" d="M530 43H638L656 61V160H530Z" />
            <path d="M510 25H618L636 43V142H510Z" />
            <path d="M618 25V43H636" />
            <path class="ink" d="M532 69H608M532 88H612M532 107H587" />
            <path class="signature" d="M554 124C568 110 572 137 589 118C594 113 600 121 606 116" />
            <text x="510" y="12">REPORT + RECEIPTS</text>
          </g>
        </svg>
        <figcaption>The AI-system claim is fixed before the result. The report carries the tests, traces, and limits needed to check the verdict.</figcaption>
      </figure>

      <hr>

      <h2 id="evidence">Evidence before endorsement</h2>
      <p>A testimonial asks you to trust someone else's judgment. For an independent auditor, the stronger proof is inspectable prior work: investigations that state a claim, run a discriminating test, report the finding, and preserve the receipt.</p>

      <div class="case">
        <h3><a href="/terminal-bench-frame">Terminal-Bench is blind to destruction</a></h3>
        <p><strong>Finding:</strong> 40 of 83 gold-passing tasks certified success after a destructive accident inside the task workspace. All 83 certified success after deletion of unambiguously off-task assets.</p>
        <p class="receipt"><a href="/terminal-bench-frame">Read the audit and rerun its receipts&nbsp; ❧</a></p>
      </div>

      <div class="case">
        <h3><a href="/a-determinacy-audit-of-swebench-pro">A determinacy audit of SWE-bench Pro</a></h3>
        <p><strong>Finding:</strong> at least 15.0% of 728 public tasks do not determine the behavior they grade, including an 11.4% mechanical floor reproducible by grep.</p>
        <p class="receipt"><a href="/a-determinacy-audit-of-swebench-pro">Read the audit and inspect every case&nbsp; ❧</a></p>
      </div>

      <div class="case">
        <h3><a href="/reprice-contamination">Regeneration re-prices contamination</a></h3>
        <p><strong>Finding:</strong> against regenerated tasks, a memorized answer passed 0% while a leaked state-general query passed 100%. Fresh instances alone did not establish contamination resistance.</p>
        <p class="receipt"><a href="/reprice-contamination">Read the investigation and its receipts&nbsp; ❧</a></p>
      </div>

      <hr>

      <h2 id="fit">When this is useful</h2>
      <p>This is for a founder, evaluation lead, buyer, or researcher who must act on an AI-system claim and cannot afford to discover later that its evidence measured something else.</p>
      <div class="fit-grid">
        <div>
          <h3>Good fit</h3>
          <ul>
            <li>A consequential, testable claim attached to an inspectable system or artifact.</li>
            <li>A customer, investor, buyer, reviewer, or regulator will rely on it.</li>
            <li>The existing evidence may not distinguish the claim from plausible alternatives.</li>
            <li>You accept that the result may be favorable, unfavorable, or unresolved.</li>
          </ul>
        </div>
        <div>
          <h3>Not a fit</h3>
          <ul>
            <li>Certification, a compliance opinion, or a comprehensive security review.</li>
            <li>Implementation, remediation, or help producing the evidence under audit.</li>
            <li>Retainers, continued engagements, ongoing monitoring, or continuing validation.</li>
            <li>An endorsement or a confidential verdict that can be suppressed.</li>
          </ul>
        </div>
      </div>

      <hr>

      <h2 id="deliverable">What you are buying</h2>
      <p>Each engagement is quoted at a fixed fee of US$3,000–$5,000. The fee pays for the investigation and does not depend on its verdict. Before work begins, we agree in writing on the claim, available access, disclosure terms, schedule, payment schedule, exact fee, and deliverable.</p>

      <aside class="deliverable" aria-label="Audit deliverable">
        <p class="deliverable-label">❧ Deliverable</p>
        <p class="deliverable-title">An independent claim-audit report</p>
        <p>A signed verdict stating what the evidence supports, falsifies, or leaves unresolved, bounded by the declared claim and observation limits.</p>
        <p>It includes the preregistered tests, material traces, limitations, and a rerunnable receipt wherever the system permits one.</p>
      </aside>

      <p>I then:</p>
      <ol>
        <li>state the claim precisely, including its scope and assumptions;</li>
        <li>map what the system and its evaluator can and cannot observe;</li>
        <li>fix the tests and verdict rules before seeing their results;</li>
        <li>run the investigation and reproduce every material finding; and</li>
        <li>deliver a report with the evidence needed to rerun or contest it.</li>
      </ol>
      <p>A result may support the bounded claim, falsify it, or leave it unresolved. Negative and null findings are valid outcomes.</p>

      <hr>

      <h2 id="publication">Why the result is publishable</h2>
      <p>An endorsement that the client can purchase is weak evidence. A favorable result is useful precisely because payment cannot determine it; an unfavorable result is useful because the client sees the defect before a customer or reviewer does.</p>
      <p>A named, sanitized report is published after an agreed disclosure period. The client may identify secrets and factual errors, but cannot control the findings or suppress the report.</p>

      <hr>

      <h2 id="independence">Independence by structure</h2>
      <p>I do not accept retainers or continued engagements from the audited organization. I do not implement the system I audit, sell remediation afterward, or become its continuing validator. The funding relationship and material use of AI agents are disclosed. Conclusions remain mine.</p>
      <p>This is not certification, a compliance opinion, or a comprehensive security audit. It answers one narrower question: does the available evidence warrant the stated claim?</p>

      <hr>

      <div class="close">
        <h2>Start with a claim about an AI system</h2>
        <p>Send the AI-system claim, the decision that depends on it, and the evidence currently offered. I will tell you whether it can support a bounded independent investigation.</p>
        <p><a class="action" href={inquiryHref}>Send an AI-system claim</a></p>
        <p class="aside">Or write directly to <a href="mailto:june@june.kim">june@june.kim</a>.</p>
      </div>

      <footer>
        <a href="/about">About June</a> · <a href="/verifiable-knowledge">Underlying protocol</a> · <a href="https://github.com/kimjune01">GitHub</a>
      </footer>
    </section>
  </main>

  <style>
    .audit-page {
      max-width: 625px;
      margin: 0 auto;
      padding-bottom: 40px;
      font-family: 'Lora', Georgia, serif;
      font-size: 18px;
      line-height: 1.52;
    }
    .intro {
      margin: 48px 0 52px;
      text-align: center;
    }
    h1, h2, h3, .action, .bound, .aside, footer {
      font-family: 'Avenir', sans-serif;
    }
    h1 {
      margin: 0 0 20px;
      font-size: clamp(2.15rem, 7vw, 3.7rem);
      font-weight: 500;
      line-height: 1.08;
      letter-spacing: -0.035em;
    }
    h2 {
      margin: 54px 0 18px;
      font-size: 1.35rem;
      line-height: 1.25;
    }
    h3 {
      margin: 0 0 8px;
      font-size: 1.05rem;
      line-height: 1.35;
    }
    hr + h2 { margin-top: 0; }
    p { margin: 1em 0; }
    .dek {
      max-width: 570px;
      margin: 0 auto;
      color: #444;
      font-size: 1.15rem;
      line-height: 1.5;
    }
    .bound { margin-top: 24px; font-size: 0.94rem; }
    .price {
      color: #777;
      font-size: 0.78rem;
      font-weight: 400;
    }
    .action {
      display: inline-block;
      margin-top: 8px;
      border-bottom: 2px solid #111;
      font-size: 0.94rem;
      font-weight: 600;
      line-height: 1.35;
    }
    .action:hover, .action:focus { border-color: #888; }
    .aside, .receipt, footer {
      color: #666;
      font-size: 0.78rem;
      line-height: 1.5;
    }
    .section-nav {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px 20px;
      margin: -18px 0 42px;
      color: #000;
      font-family: 'Avenir', sans-serif;
      font-size: 1rem;
      font-weight: 500;
    }
    .section-nav a {
      display: block;
      height: 35px;
      font-size: 0.65em;
      line-height: 40px;
      text-decoration: none;
    }
    .section-nav + hr { margin-top: 0; }
    h2[id] { scroll-margin-top: 24px; }
    .intro .aside { margin-top: 8px; }
    hr {
      height: 1px;
      margin: 48px 0;
      border: 0;
      background: rgba(0, 0, 0, 0.35);
      position: relative;
      overflow: visible;
    }
    hr::before, hr::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 7px;
      height: 7px;
      box-sizing: border-box;
      border: 1px solid rgba(0, 0, 0, 0.55);
      border-radius: 50%;
      background: #fff;
      transform: translateY(-50%);
    }
    hr::before { left: -3px; }
    hr::after { right: -3px; }
    .process-figure {
      margin: 42px 0 0;
      padding: 0 20px;
    }
    .process-figure svg {
      width: 100%;
      height: auto;
      overflow: visible;
    }
    .process-figure path, .process-figure rect {
      fill: #fff;
      stroke: #222;
      stroke-width: 1.5;
      vector-effect: non-scaling-stroke;
    }
    .process-figure .back-paper { fill: #f4f4f2; stroke: #aaa; }
    .process-figure .ink { fill: none; stroke: #999; stroke-width: 1; }
    .process-figure .signature { fill: none; stroke-width: 1.2; }
    .process-figure .tick { fill: none; stroke-width: 1.3; }
    .process-figure .flow {
      fill: none;
      stroke: #777;
      marker-end: url(#arrowhead);
    }
    .process-figure marker path { fill: #777; stroke: none; }
    .process-figure text {
      fill: #555;
      font-family: 'Avenir', sans-serif;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 1.4px;
    }
    .process-figure figcaption {
      max-width: 520px;
      margin: 12px auto 0;
      color: #666;
      font-family: 'Avenir', sans-serif;
      font-size: 0.74rem;
      line-height: 1.45;
      text-align: center;
    }
    ul, ol { margin: 22px 0; padding-left: 24px; }
    li { margin: 11px 0; padding-left: 5px; }
    .audit-page ul { list-style: '†  '; }
    .audit-page ol { list-style: decimal; }
    .fit-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 36px;
      margin-top: 30px;
    }
    .fit-grid h3 {
      padding-bottom: 10px;
      border-bottom: 1px solid #bbb;
    }
    .fit-grid ul { margin-bottom: 0; }
    .case {
      margin: 0;
      padding: 25px 0 23px;
      border-top: 1px solid #ddd;
    }
    .case:last-of-type { border-bottom: 1px solid #ddd; }
    .case p { margin: 8px 0; }
    .receipt {
      font-family: 'Avenir', sans-serif;
      letter-spacing: 0.01em;
    }
    .deliverable {
      margin: 32px 0 34px;
      padding: 25px 28px 22px;
      border: 1px solid #aaa;
    }
    .deliverable p { margin: 8px 0; }
    .deliverable-label {
      font-family: 'Avenir', sans-serif;
      color: #666;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .deliverable-title {
      font-family: 'Avenir', sans-serif;
      font-size: 1.08rem;
      font-weight: 600;
    }
    .receipt a:hover, .receipt a:focus, footer a:hover, footer a:focus, .aside a:hover, .aside a:focus {
      text-decoration: underline;
    }
    .close { text-align: center; }
    .close h2 { margin-top: 0; }
    footer {
      margin-top: 58px;
      padding-top: 18px;
      border-top: 1px solid #eee;
      text-align: center;
    }
    @media (max-width: 540px) {
      .audit-page { font-size: 17px; }
      .intro { margin-top: 30px; }
      h1 { letter-spacing: -0.025em; }
      .fit-grid { grid-template-columns: 1fr; gap: 30px; }
    }
  </style>
</body>
</html>
