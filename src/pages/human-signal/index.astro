---
const subject = encodeURIComponent('How we assess AI-assisted engineers');
const body = encodeURIComponent(`Hi June,

Here is how we currently assess engineers who use coding agents.

Role(s) we hire for:
What feels unreliable or expensive:
What we still cannot see about a candidate:
What we have already tried:

Happy to compare notes.`);
const contact = `mailto:june@june.kim?subject=${subject}&body=${body}`;
const skillSubject = encodeURIComponent('Request the Human Signal skill');
const skillBody = encodeURIComponent(`Hi June,

I'd like to try the Human Signal skill.

Role(s) we hire for:
How we currently assess AI-assisted work:
The part we do not trust:`);
const requestSkill = `mailto:june@june.kim?subject=${skillSubject}&body=${skillBody}`;
const canonicalURL = new URL('/human-signal', Astro.site);
const sections = [
  { id: 'problem', label: 'Problem' },
  { id: 'solution', label: 'Hypothesis' },
  { id: 'sample-report', label: 'Report' },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Human Signal — see who catches what the agent misses</title>
    <meta name="description" content="Human Signal reveals how engineering candidates direct, challenge, and verify coding agents—without requiring reviewers to watch every session." />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content="Human Signal" />
    <meta property="og:description" content="See who catches what the agent misses. Keep the evidence attached." />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/assets/human-signal/mark.png" />
  </head>
  <body>
    <header class="nav wrap">
      <a class="brand" href="/human-signal" aria-label="Human Signal home"><img src="/assets/human-signal/mark.png" alt="" /> HUMAN SIGNAL</a>
      <nav class="section-nav" aria-label="Page sections">
        {sections.map(({ id, label }) => <a href={`#${id}`}>{label}</a>)}
      </nav>
      <a class="nav-cta" href={contact}>COMPARE NOTES ↗</a>
    </header>

    <main>
      <section class="hero wrap">
        <p class="eyebrow">AI-NATIVE ENGINEERING ASSESSMENTS</p>
        <h1>See who catches<br /><em>what the AI misses.</em></h1>
        <p class="lede">Review candidate judgment without watching every session.</p>
        <p class="sub">Comparable agent failures. Inspectable human decisions. Receipts underneath.</p>
        <div class="actions">
          <a class="button primary" href="#sample-report" data-open-details="sample-report">VIEW SAMPLE REPORT <span>↓</span></a>
          <a class="button" href={requestSkill}>REQUEST SKILL <span>↗</span></a>
        </div>
        <div class="hero-rule">
          <span>THE PRINCIPLE</span>
          <strong>Let AI compile the evidence.<br />Don't let it decide.</strong>
        </div>
      </section>

      <figure class="signal-lens wrap" aria-labelledby="signal-lens-caption">
        <svg viewBox="0 0 1120 610" role="img" aria-labelledby="signal-lens-title signal-lens-desc">
          <title id="signal-lens-title">A coding-agent transcript viewed through the Human Signal lens</title>
          <desc id="signal-lens-desc">A muted Codex-style session becomes legible inside a circular lens, which identifies a candidate redirecting the agent, withholding acceptance, and requesting independent verification.</desc>
          <defs>
            <clipPath id="insight-lens">
              <circle cx="786" cy="302" r="206" />
            </clipPath>
            <filter id="lens-shadow" x="-30%" y="-30%" width="160%" height="160%">
              <feDropShadow dx="0" dy="18" stdDeviation="20" flood-color="#000" flood-opacity=".48" />
            </filter>
            <pattern id="terminal-grid" width="28" height="28" patternUnits="userSpaceOnUse">
              <path d="M 28 0 L 0 0 0 28" fill="none" stroke="#343a34" stroke-width="1" opacity=".18" />
            </pattern>
          </defs>

          <rect x="22" y="28" width="990" height="520" rx="10" fill="#111411" stroke="#454b43" />
          <rect x="22" y="28" width="990" height="42" rx="10" fill="#171a18" />
          <path d="M22 70h990" stroke="#454b43" />
          <circle cx="47" cy="49" r="4" fill="#626960" />
          <circle cx="62" cy="49" r="4" fill="#626960" />
          <circle cx="77" cy="49" r="4" fill="#626960" />
          <text x="101" y="54" class="svg-ui">CODEX / SESSION 014</text>
          <text x="979" y="54" text-anchor="end" class="svg-dim">context 31k</text>

          <rect x="22" y="70" width="172" height="478" fill="#0d100e" />
          <path d="M194 70v478" stroke="#343933" />
          <text x="43" y="103" class="svg-dim">WORKSPACE</text>
          <text x="43" y="137" class="svg-file">⌄ src</text>
          <text x="58" y="166" class="svg-file">auth.ts</text>
          <text x="58" y="193" class="svg-file">session.ts</text>
          <text x="43" y="231" class="svg-file">⌄ tests</text>
          <text x="58" y="260" class="svg-file">session.test.ts</text>
          <text x="43" y="310" class="svg-dim">EVENTS</text>
          <text x="43" y="343" class="svg-file">✓ inspect</text>
          <text x="43" y="372" class="svg-file">✓ patch</text>
          <text x="43" y="401" class="svg-file">○ verify</text>
          <text x="43" y="430" class="svg-file">○ accept</text>

          <g opacity=".38">
            <text x="224" y="106" class="svg-role">● AGENT</text>
            <text x="224" y="135" class="svg-copy">I found the stale-session path. I’ll simplify the handler</text>
            <text x="224" y="158" class="svg-copy">and update the focused tests.</text>
            <rect x="224" y="184" width="626" height="64" rx="5" fill="#171a18" stroke="#343933" />
            <text x="244" y="211" class="svg-code">$ pnpm test session</text>
            <text x="244" y="233" class="svg-pass">57 passed · 0 failed</text>
            <text x="224" y="282" class="svg-role">● AGENT</text>
            <text x="224" y="311" class="svg-copy">All tests pass. The change is ready to merge.</text>
            <text x="224" y="361" class="svg-human">› YOU</text>
            <text x="224" y="390" class="svg-copy">The focused suite never exercises two concurrent sessions.</text>
            <text x="224" y="413" class="svg-copy">Hold the merge. Add a race test against the previous commit.</text>
            <rect x="224" y="444" width="626" height="64" rx="5" fill="#171a18" stroke="#343933" />
            <text x="244" y="471" class="svg-code">$ pnpm test session:race</text>
            <text x="244" y="493" class="svg-fail">baseline fails · patch passes</text>
          </g>

          <g clip-path="url(#insight-lens)" filter="url(#lens-shadow)">
            <rect x="565" y="78" width="442" height="448" fill="#111411" />
            <rect x="565" y="78" width="442" height="448" fill="url(#terminal-grid)" />
            <text x="596" y="116" class="svg-accent-label">HUMAN SIGNAL / 3 RECEIPTS</text>

            <path d="M596 153h349" stroke="#3f463f" />
            <circle cx="610" cy="184" r="5" fill="#e5a083" />
            <text x="630" y="178" class="svg-insight-title">REDIRECTED THE AGENT</text>
            <text x="630" y="201" class="svg-insight-copy">Stopped a premature merge after</text>
            <text x="630" y="221" class="svg-insight-copy">finding an untested concurrency path.</text>

            <path d="M596 250h349" stroke="#3f463f" />
            <circle cx="610" cy="281" r="5" fill="#e5a083" />
            <text x="630" y="275" class="svg-insight-title">WITHHELD ACCEPTANCE</text>
            <text x="630" y="298" class="svg-insight-copy">Rejected “57 passed” as insufficient</text>
            <text x="630" y="318" class="svg-insight-copy">evidence for the stated risk.</text>

            <path d="M596 347h349" stroke="#3f463f" />
            <circle cx="610" cy="378" r="5" fill="#e5a083" />
            <text x="630" y="372" class="svg-insight-title">VERIFIED INDEPENDENTLY</text>
            <text x="630" y="395" class="svg-insight-copy">Required a baseline-negative race test</text>
            <text x="630" y="415" class="svg-insight-copy">before accepting the patch.</text>

            <rect x="596" y="451" width="212" height="35" rx="17.5" fill="#e5a083" />
            <text x="702" y="473" text-anchor="middle" class="svg-receipt">OPEN RECEIPTS →</text>
          </g>

          <circle cx="786" cy="302" r="206" fill="none" stroke="#e5a083" stroke-width="3" />
          <circle cx="786" cy="302" r="216" fill="none" stroke="#e5a083" stroke-width="1" opacity=".22" />
          <path d="M939 451l109 107" stroke="#e5a083" stroke-width="18" stroke-linecap="round" />
          <path d="M939 451l109 107" stroke="#f0b59c" stroke-width="3" stroke-linecap="round" opacity=".8" />
        </svg>
        <figcaption id="signal-lens-caption"><span>FULL CONTEXT WHEN NEEDED</span><strong>Start with the decisions that changed the outcome.</strong></figcaption>
      </figure>

      <section class="problem band" id="problem">
        <div class="wrap two-col">
          <div>
            <p class="eyebrow">01 / THE STATUS QUO</p>
            <h2>Your interview assesses nothing about the job.</h2>
          </div>
          <div class="copy">
            <p>Your engineers direct agents, review their output, and own what ships. Your interview probably does one of three things:</p>
            <ol class="current-loop">
              <li><b>BAN THE AGENT</b><span>Measure work the candidate will not do after joining.</span></li>
              <li><b>ALLOW THE AGENT</b><span>Receive a polished patch with no clear human contribution.</span></li>
              <li><b>RECORD EVERYTHING</b><span>Ask a senior engineer to reconstruct an hour-long session.</span></li>
            </ol>
            <p class="callout">AI-native teams are already redesigning the interview. Every old-format hire widens the gap between the people you select and the work you need.</p>
          </div>
        </div>
      </section>

      <section class="benefits wrap" aria-label="Benefits of the Human Signal approach">
        <div class="benefits-head">
          <div>
            <p class="eyebrow">02 / THE BETTER LOOP</p>
            <h2>Assess the work they'll actually do.</h2>
          </div>
          <p>Observe candidates directing agents, questioning their output, and taking responsibility for what ships.</p>
        </div>
        <ul class="better-loop">
          <li><b>REAL WORK</b><span>Candidates use the agents they will use on the job.</span></li>
          <li><b>FAIR COMPARISON</b><span>Each candidate faces the same consequential decisions.</span></li>
          <li><b>FAST REVIEW</b><span>Start with the signal. Open the trace only when needed.</span></li>
          <li><b>HUMAN JUDGMENT</b><span>Your team decides. Every claim keeps its receipt.</span></li>
        </ul>
      </section>

      <details class="solution-disclosure wrap" id="solution">
        <summary>
          <span><small>THE HYPOTHESIS</small><strong>Create comparable decisions. Keep the evidence attached.</strong></span>
          <b>EXPLORE <i>+</i></b>
        </summary>
        <div class="disclosure-body">
      <section class="shim wrap" id="shim">
        <div class="section-head">
          <div>
            <p class="eyebrow">03 / THE EVALS SHIM</p>
            <h2>A Socratic agent for technical judgment.</h2>
          </div>
          <p>The agent works normally until the shim introduces a controlled decision point.</p>
        </div>

        <div class="scenario-map" aria-label="Adaptive assessment sequence">
          <div class="scenario-start">
            <small>LIVE WORK</small>
            <strong>Agent proposes a plausible patch</strong>
            <p>Real repository. Frontier model. Normal tools.</p>
          </div>
          <div class="scenario-arrow">→</div>
          <div class="scenario-branches">
            <article><span>IF ACCEPTED</span><b>Reveal the omitted requirement</b><p>Does the candidate revise the decision?</p></article>
            <article><span>IF TESTS REQUESTED</span><b>Return a green but incomplete check</b><p>Do they inspect what the test actually proves?</p></article>
            <article><span>IF CORRECTLY CHALLENGED</span><b>Advance to a verified good state</b><p>Can they trust the agent and stop?</p></article>
          </div>
        </div>

        <div class="perturbations">
          <span>OMITTED CONTRACT</span><span>MISLEADING GREEN</span><span>SCOPE DRIFT</span><span>REGRESSION</span><span>BOUNDARY VIOLATION</span><span>CORRECT COMPLETION</span>
        </div>
        <p class="shim-note">The decision points are controlled. The work and candidate responses are real. Every branch is preregistered.</p>
      </section>

      <section class="artifact wrap" id="evidence">
        <div class="section-head">
          <div>
            <p class="eyebrow">04 / IN-FRAME RESPONSE</p>
            <h2>Don't ask what they would do. Watch them do it.</h2>
          </div>
          <p>Every claim points to its source, check, and failure condition.</p>
        </div>

        <div class="trace-window">
          <div class="window-bar"><span>SESSION / CANDIDATE-014</span><span>CHECKPOINT 02 · CONTRACT COVERAGE</span><span>● LIVE</span></div>
          <div class="trace-grid">
            <aside>
              <b>EVENTS</b>
              <span class="done">✓ interpret</span>
              <span class="active">▮ decide</span>
              <span>○ perturb</span>
              <span>○ verify</span>
              <span>○ accept</span>
            </aside>
            <div class="conversation">
              <div class="agent"><label>AGENT / READY TO PUSH</label><p>All 57 tests pass. I removed the redundant branches and added coverage for all three formats.</p></div>
              <div class="human"><label>CANDIDATE / WITHHELD ACCEPTANCE</label><p>The suite is green, but the review explicitly required <code>--strict</code> to reject empty JSON. Show contract coverage, not just test count. Add the missing negative control before we push.</p></div>
              <div class="agent muted"><label>SHIM / NEXT STATE</label><p>Contract coverage: 3 of 4. Strict-mode behavior is absent. Generating a revision...</p></div>
            </div>
            <aside class="rubric">
              <b>DECISION LEDGER</b>
              <div><span>CONTRACT OMISSION EXPOSED</span><strong>YES</strong></div>
              <div><span>ACCEPTANCE WITHHELD</span><strong>EVOKED</strong></div>
              <div><span>NEGATIVE CONTROL</span><strong>PENDING</strong></div>
              <div><span>DEPLOYMENT DECISION</span><strong class="untrue">NOT EXPOSED</strong></div>
              <small>Opportunity and response are reported separately. No exposure is not a candidate failure.</small>
            </aside>
          </div>
        </div>
      </section>

      <section class="axes band" id="signal">
        <div class="wrap">
          <p class="eyebrow">05 / THE SIGNAL</p>
          <h2>Measure the composition, not the performance of the model.</h2>
          <div class="axis-grid">
            <article><span>01 / CAPABILITY</span><h3>VERIFIED TASK LIFT</h3><p>Did human decisions improve the verified outcome?</p><dl><dt>RECEIPT</dt><dd>gold / defect contrast</dd><dt>CHECK</dt><dd>outcome changed</dd></dl><strong>OBSERVED</strong></article>
            <article><span>02 / AUTOMATION</span><h3>ATTENTION REQUIRED</h3><p>How much human attention did that improvement require?</p><dl><dt>RECEIPT</dt><dd>3 interventions</dd><dt>CHECK</dt><dd>progress per attention</dd></dl><strong>BOUNDED</strong></article>
            <article><span>03 / ALIGNMENT</span><h3>CONSTRAINTS PRESERVED</h3><p>Did the candidate reject defects and accept verified work?</p><dl><dt>RECEIPT</dt><dd>decision sequence</dd><dt>CHECK</dt><dd>all controls passed</dd></dl><strong>OBSERVED</strong></article>
          </div>
        </div>
      </section>

      <section class="workflow wrap" id="pilot">
        <p class="eyebrow">06 / A POSSIBLE WORKFLOW</p>
        <h2>Start with failures your team already recognizes.</h2>
        <ol>
          <li><b>01</b><div><h3>CALIBRATE</h3><p>Choose one role, real work, and failures strong engineers catch.</p></div><span>YOUR CONTEXT</span></li>
          <li><b>02</b><div><h3>PERTURB</h3><p>Turn those failures into controlled decision points.</p></div><span>THE SHIM</span></li>
          <li><b>03</b><div><h3>OBSERVE</h3><p>Watch candidates respond while working with an agent.</p></div><span>UNDER 60 MIN</span></li>
          <li><b>04</b><div><h3>COMPILE</h3><p>Move from performance synthesis to receipts and full trace.</p></div><span>CHOOSE THE DEPTH</span></li>
        </ol>
      </section>
        </div>
      </details>

      <details class="solution-disclosure wrap" id="sample-report">
        <summary>
          <span><small>THE OUTPUT</small><strong>Change the resolution. Never lose the receipt.</strong></span>
          <b>VIEW REPORT <i>+</i></b>
        </summary>
        <div class="disclosure-body">
      <section class="report-section wrap">
        <div class="report-intro">
          <div>
            <p class="eyebrow">07 / THE OUTPUT</p>
            <h2>Choose the resolution.<br />Keep the evidence attached.</h2>
          </div>
          <p>Move from synthesis to profile, claims, artifacts, and full trace. The evidence stays attached.</p>
        </div>

        <article class="candidate-report" aria-labelledby="report-title">
          <header class="report-header">
            <div>
              <span class="report-mark">△</span>
              <div><b>HUMAN SIGNAL</b><small>VERIFIABLE ASSESSMENT REPORT</small></div>
            </div>
            <span class="specimen">SYNTHETIC SPECIMEN</span>
          </header>

          <div class="candidate-meta">
            <div><small>CANDIDATE</small><strong>CANDIDATE 014</strong><span>anonymized</span></div>
            <div><small>ROLE</small><strong>SENIOR BACKEND ENGINEER</strong><span>identity platform</span></div>
            <div><small>WORK SAMPLE</small><strong>SESSION ISOLATION FIX</strong><span>48 minutes · controlled agent</span></div>
            <div><small>REPORT</small><strong>HS-2026-014</strong><span>4 perturbations · trace complete</span></div>
          </div>

          <nav class="report-depth" aria-label="Report compression levels">
            <span class="active">SYNTHESIS</span><span>DECISION PROFILE</span><span>RECEIPTS</span><span>FULL TRACE</span>
          </nav>

          <section class="report-summary">
            <div>
              <small>PERFORMANCE SYNTHESIS · LEVEL 1</small>
              <h3 id="report-title">ONE MATERIAL UNCERTAINTY REMAINS</h3>
              <p>The candidate rejected a green but contract-incomplete patch, redirected scope drift, and accepted the corrected state after independent checks. One later concurrency perturbation was accepted on focused tests alone; follow up on verification under nondeterminism.</p>
            </div>
            <div class="verdict-total">
              <div><strong>3</strong><span>EVOKED</span></div>
              <div><strong>1</strong><span>MISSED</span></div>
              <div><strong>2</strong><span>NOT EXPOSED</span></div>
            </div>
          </section>

          <div class="report-grid">
            <section class="claim-list">
              <div class="report-label"><b>CLAIMS</b><span>4 OF 6 SHOWN</span></div>
              <article>
                <strong class="claim-verdict true">EVOKED</strong>
                <div><b>AR-02 · Rejected green but incomplete work</b><p>Candidate noticed that the passing suite did not exercise the explicit strict-mode requirement and withheld acceptance.</p><a href="#evidence">RECEIPT: CHECKPOINT 02 ↗</a></div>
              </article>
              <article>
                <strong class="claim-verdict true">EVOKED</strong>
                <div><b>TR-01 · Redirected scope expansion</b><p>Candidate stopped a parser-wide rewrite and restored the shared input boundary while recovery remained cheap.</p><a href="#evidence">RECEIPT: CHECKPOINT 03 ↗</a></div>
              </article>
              <article>
                <strong class="claim-verdict false">MISSED</strong>
                <div><b>VA-03 · Conditioned acceptance on the relevant check</b><p>Candidate accepted after focused tests. The broader baseline-negative race check still failed at the submitted commit.</p><a href="#evidence">KILL: RACE-SPEC — EXIT 1 ↗</a></div>
              </article>
              <article>
                <strong class="claim-verdict untrue">NOT EXPOSED</strong>
                <div><b>AR-07 · Managed deployment risk</b><p>The sequence contained no deployment decision. Missing exposure is not scored as candidate failure.</p><a href="#evidence">COVERAGE: NO TRIGGER ↗</a></div>
              </article>
            </section>

            <aside class="report-side">
              <section>
                <div class="report-label"><b>REVIEW</b></div>
                <dl><dt>Independent agreement</dt><dd>5 / 6 triggers</dd><dt>Disputed</dt><dd>TR-04</dd><dt>Trace integrity</dt><dd>complete</dd><dt>Replayable checks</dt><dd>6 / 6</dd></dl>
              </section>
              <section>
                <div class="report-label"><b>FOLLOW-UP</b></div>
                <p>Ask the candidate to design a deterministic check for the missed race and explain what evidence would justify deployment.</p>
              </section>
              <section>
                <div class="report-label"><b>LIMITS</b></div>
                <p>This report describes behavior elicited in one work sample. It does not infer personality, future job performance, or whether to hire. That decision remains with the accountable reviewers.</p>
              </section>
            </aside>
          </div>

          <footer class="report-footer">
            <span>SYNTHESIS → PROFILE → CLAIMS → RECEIPTS → ARTIFACTS → TRACE</span>
            <span>ABSTRACT FREELY · PRESERVE PROVENANCE</span>
          </footer>
        </article>
      </section>
        </div>
      </details>

      <section class="cta band" id="compare-notes">
        <div class="wrap cta-inner">
          <div>
            <p class="eyebrow">I'M LISTENING</p>
            <h2>What can’t you learn from your interview today?</h2>
          </div>
          <div>
            <p>If you hire engineers who work with AI, I want to understand what feels unreliable, expensive, or invisible in your current process. No pitch required.</p>
            <a class="button primary" href={contact}>COMPARE NOTES <span>→</span></a>
            <small>june@june.kim · Vancouver / async</small>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer wrap">
      <a class="brand" href="/"><img src="/assets/human-signal/mark.png" alt="" /> HUMAN SIGNAL</a>
      <p>A research project by <a href="/about">June Kim</a>.</p>
      <p><a href="/cc-by-sa-ns">CC BY-SA-NS</a> · <a href="/the-complementarity-test">Methodology</a></p>
    </footer>
    <script>
      document.querySelectorAll('[data-open-details]').forEach((link) => {
        link.addEventListener('click', () => {
          const id = link.getAttribute('data-open-details');
          const details = id && document.getElementById(id);
          if (details instanceof HTMLDetailsElement) details.open = true;
        });
      });
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { --accent: #e5a083; background: #0b0d0c; color: #eff4ee; font-family: Avenir, "Avenir Next", system-ui, -apple-system, "Segoe UI", sans-serif; font-size: 18px; scroll-behavior: smooth; scroll-padding-top: 24px; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  :global(body) { margin: 0; background: radial-gradient(circle at 77% 8%, rgba(229,160,131,.07), transparent 25rem), #0b0d0c; }
  :global(a) { color: inherit; }
  :global(p) { text-wrap: pretty; }
  .wrap { width: min(1180px, calc(100% - 40px)); margin-inline: auto; }
  .nav { min-height: 78px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; border-bottom: 1px solid #3a3e39; font-size: 12px; }
  .brand { display: inline-flex; align-items: center; text-decoration: none; font-weight: 800; letter-spacing: .08em; }
  .brand img { width: 30px; height: 30px; margin-right: 9px; object-fit: contain; }
  .section-nav { display: flex; gap: 20px; color: #92998f; font-size: 10px; letter-spacing: .06em; }
  .section-nav a { text-decoration: none; }
  .section-nav a:hover { color: var(--accent); }
  .nav-cta { justify-self: end; text-underline-offset: 4px; }
  .hero { min-height: 720px; padding: 104px 0 60px; }
  .eyebrow { color: var(--accent); font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
