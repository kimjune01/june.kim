---
interface Props { videos: { id: string; title: string }[]; }
const { videos } = Astro.props;
---
<aside class="text-gray-500 text-sm mt-8" aria-label="Related StatQuest videos">
  <p>📺 StatQuest: {videos.map((video, index) => <span>{index > 0 && ' · '}<a href={`https://www.youtube.com/watch?v=${video.id}`}>{video.title} ↗</a></span>)}</p>
</aside>
