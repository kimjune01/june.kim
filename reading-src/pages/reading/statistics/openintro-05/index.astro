        <text x="340" y="135" text-anchor="middle" fill="#ef4444" font-size="9" fill-opacity="0.7">reject</text>
        <text x="200" y="110" text-anchor="middle" fill="#3b82f6" font-size="10" fill-opacity="0.6">fail to reject</text>
        <text x="95" y="155" text-anchor="middle" fill="currentColor" font-size="9" fill-opacity="0.4">-z*</text>
        <text x="200" y="155" text-anchor="middle" fill="currentColor" font-size="9" fill-opacity="0.4">&#x3bc;&#x2080;</text>
        <text x="305" y="155" text-anchor="middle" fill="currentColor" font-size="9" fill-opacity="0.4">+z*</text>
