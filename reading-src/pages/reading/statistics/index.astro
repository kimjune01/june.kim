---
import {course,chapterHref} from '../../../lib/statistics/course';
import ChapterTable from '../../../components/ChapterTable.astro';
import Layout from '../../../layouts/Base.astro';
import Neighbors from '../../../components/Neighbors.astro';
---

<Layout title="Statistics" favicon="◒">
  <main>
    <a href="/reading/" class="text-sm mb-4 inline-block">&larr; back to reading</a>

    <h1>◒ Statistics</h1>
    <p class="text-gray-400 mb-2">The reading guide follows <a href="https://www.openintro.org/book/os/">OpenIntro Statistics</a>, licensed <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a>.</p>
    <p class="text-gray-400 mb-6">Small experiments, diagrams, and plain English. Runnable Scheme and Python in the deeper chapters.</p>

    <div class="flex justify-center my-6">
      <svg viewBox="0 0 400 180" class="w-full max-w-md" role="img" aria-labelledby="statistics-outline-figure" style="font-family: ui-monospace, monospace;">
        <title id="statistics-outline-figure">Distribution of the number of heads in ten independent fair coin flips. Five heads is most likely; zero and ten are rare.</title>
        <line x1="40" y1="130" x2="360" y2="130" stroke="currentColor" stroke-width="1" stroke-opacity="0.3" />
        {[1, 10, 45, 120, 210, 252, 210, 120, 45, 10, 1].map((count, i) => (
          <rect x={46 + i * 28} y={130 - count / 252 * 90} width="24" height={count / 252 * 90} fill={i === 5 ? '#f59e0b' : '#60a5fa'} fill-opacity="0.4" />
        ))}
        <text x="58" y="146" text-anchor="middle" fill="currentColor" font-size="10" fill-opacity="0.5">0</text>
        <text x="198" y="146" text-anchor="middle" fill="currentColor" font-size="10" fill-opacity="0.5">5</text>
        <text x="338" y="146" text-anchor="middle" fill="currentColor" font-size="10" fill-opacity="0.5">10</text>
        <text x="200" y="22" text-anchor="middle" fill="currentColor" font-size="10" fill-opacity="0.5">ten fair coins, one head count</text>
        <text x="200" y="168" text-anchor="middle" fill="currentColor" font-size="10" fill-opacity="0.5">number of heads → a distribution</text>
      </svg>
    </div>

    <h2>Statistics through experiments</h2>
    <p class="text-gray-400 mb-6">Start here. Try an idea, give it a name, then arrive at the definition, formula, or theorem it helps you understand. Sixteen chapters take you from first definitions through a university introduction: describing data, sampling, inference, experiment design, and regression. No statistics or programming background needed.</p>
    <ChapterTable chapters={course.map(chapter=>({href:chapterHref(chapter.slug),title:chapter.title,desc:chapter.desc}))} icon="◒" iconClass="text-blue-300 hover:text-blue-200" />

    <h2>The OpenIntro reading guide</h2>
    <p class="text-gray-400 mb-6">Go deeper with worked examples and runnable code. For the mathematics behind chance, follow the companion <a href="/reading/probability/">Introduction to Probability</a>.</p>
    <ChapterTable chapters={[
      { href: '/reading/statistics/openintro-01/', title: 'Introduction to Data', desc: 'Observations, variables, and study design: what we measure and how we choose it' },
      { href: '/reading/statistics/openintro-02/', title: 'Summarizing Data', desc: 'Center, spread, and tables: what a summary captures and leaves out' },
      { href: '/reading/statistics/openintro-03/', title: 'Probability', desc: 'Events, conditional probability, and independence: how chances combine' },
      { href: '/reading/statistics/openintro-04/', title: 'Distributions', desc: 'Normal, binomial, Poisson, and geometric: the shapes of repeated experiments' },
      { href: '/reading/statistics/openintro-05/', title: 'Foundations for Inference', desc: 'Estimates, intervals, and tests: learning about a population from a sample' },
      { href: '/reading/statistics/openintro-06/', title: 'Inference for Proportions', desc: 'Counts, percentages, and categories: comparing outcomes with uncertainty' },
      { href: '/reading/statistics/openintro-07/', title: 'Inference for Means', desc: 't tests, paired data, and ANOVA: comparing averages' },
      { href: '/reading/statistics/openintro-08/', title: 'Simple Linear Regression', desc: 'Least squares, residuals, and prediction: fitting a line and reading its errors' },
      { href: '/reading/statistics/openintro-09/', title: 'Multiple and Logistic Regression', desc: 'Several predictors, adjusted fit, and probabilities for yes-or-no outcomes' },
    ]} icon="◒" iconClass="text-blue-300 hover:text-blue-200" />

    <p class="text-gray-500 text-sm mt-8">📺 <a href="https://www.youtube.com/user/joshstarmer">StatQuest videos ↗</a></p>
    <p class="text-gray-500 text-sm">OpenIntro Statistics is by David Diez, Mine Çetinkaya-Rundel, and Christopher Barr. The introductory chapters include their own source credits and licensing.</p>

    <Neighbors>
      <ul class="neighbors">
        <li><a href="/reading/probability/">🎰 Introduction to Probability</a> — the companion textbook, from events and counting to expectation and limit theorems</li>
        <li><a href="/reading/scientific-method/">🔬 Scientific Method</a> — evidence, significance, and replication</li>
        <li><a href="/reading/machine-learning/">🤖 Machine Learning</a> — learning patterns from data</li>
        <li><a href="/reading/information-theory/">📡 Information Theory</a> — measuring uncertainty and information</li>
      </ul>
    </Neighbors>
  </main>
</Layout>
